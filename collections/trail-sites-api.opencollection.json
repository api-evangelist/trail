                "name": "Content_Type",
                "value": ""
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "API_KEY",
              "value": "{{API_KEY}}",
              "placement": "header"
            }
          },
          "docs": "Retrieves sites"
        }
      ]
    }
  ],
  "bundled": true
